# Copy to keeper/.env (untracked; loaded on start) or export in your shell.
# Testnet-only keys. Never commit real ones.

# testnet (chain 10143) or monad (chain 143)
CHAIN=testnet
# Provider HTTP RPC, e.g. Alchemy Monad testnet
RPC_URL=
# Optional provider WebSocket RPC for block subscriptions; without it the keeper polls every 200ms
WS_URL=
# Fallback RPC; defaults to the chain's public RPC (rate-limited)
PUBLIC_RPC_URL=
KEEPER_PRIVATE_KEY=
SHIELD_ADDRESS=
# Deploy block from demo/.deployments.json; optional when USERS is set
DEPLOY_BLOCK=
# Optional static comma-separated user list; skips the event backfill
USERS=
HEARTBEAT_EVERY_BLOCKS=30
# eth_getLogs range per call; Monad public RPC caps it at 100
LOG_CHUNK=100
CONCURRENCY=16
STATUS_PORT=8787
DRY_RUN=false

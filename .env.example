# Copy to `.env` (gitignored). Testnet only (Monad testnet, chain 10143). Never put mainnet keys here.

# RPC: official Monad testnet endpoints. WS (block subscriptions, no polling) first, HTTP fallback.
# RPC_URL unset = public https://testnet-rpc.monad.xyz
RPC_URL=
WS_URL=wss://testnet-rpc.monad.xyz

# Operator: deploys, owns TestnetAave (oracle, faucet), seeds runs. Fund from https://faucet.monad.xyz
OPERATOR_PRIVATE_KEY=
# Keeper calls protect(); liquidator liquidates Alice. Both funded with MON by `demo:deploy`.
KEEPER_PRIVATE_KEY=
LIQUIDATOR_PRIVATE_KEY=
# Alice/Bob per run n are derived at index 2n / 2n+1
DEMO_MNEMONIC=

# MON sent by deploy (keeper, liquidator) and seed (each of Alice, Bob). Deploy costs ~1.4 MON gas; seed (Reset) ~0.25 incl. transfers (users spend ~0.07 each). One 5 MON faucet drip covers deploy + ~8 runs.
KEEPER_GAS_MON=1
LIQUIDATOR_GAS_MON=0.3
DEMO_USER_GAS_MON=0.1

# Product page faucet (/): 10 tWETH per wallet, once; plus this MON gas drip for wallets with almost none,
# capped at FAUCET_MAX_DRIPS per web-server run so a public page can't drain the operator.
FAUCET_GAS_MON=0.05
FAUCET_MAX_DRIPS=30

# Written into web/.env.local by deploy
KEEPER_URL=http://localhost:8787

# `demo:deploy` upserts CHAIN, RPC_URL, WS_URL, KEEPER_PRIVATE_KEY, SHIELD_ADDRESS, DEPLOY_BLOCK into keeper/.env;
# other keeper settings live there (see keeper/.env.example).

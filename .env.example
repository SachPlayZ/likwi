# Copy to `.env` (gitignored). Testnet only (Monad testnet, chain 10143). Never put mainnet keys here.

# RPC: provider WS for the keeper, HTTP fallback. Unset = public https://testnet-rpc.monad.xyz
RPC_URL=
WS_URL=

# Operator: deploys, owns TestnetAave (oracle, faucet), seeds runs. Fund from https://faucet.monad.xyz
OPERATOR_PRIVATE_KEY=
# Keeper calls protect(); liquidator liquidates Alice. Both funded with MON by `demo:deploy`.
KEEPER_PRIVATE_KEY=
LIQUIDATOR_PRIVATE_KEY=
# Alice/Bob per run n are derived at index 2n / 2n+1
DEMO_MNEMONIC=

# MON sent by deploy (keeper, liquidator) and seed (each of Alice, Bob). Deploy costs ~1.4 MON gas; seed ~0.7 incl. transfers. One 5 MON faucet drip covers deploy + ~2 runs.
KEEPER_GAS_MON=1
LIQUIDATOR_GAS_MON=0.3
DEMO_USER_GAS_MON=0.3

# Written into web/.env.local by deploy
KEEPER_URL=http://localhost:8787

# Keeper overrides (default: shield + current run from demo/.deployments.json)
# SHIELD_ADDRESS=
# USERS=0x...,0x...
# DRY_RUN=true

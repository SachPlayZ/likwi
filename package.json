{
  "name": "liquidation-shield",
  "private": true,
  "workspaces": [
    "contracts",
    "packages/shared",
    "keeper",
    "demo",
    "web"
  ],
  "scripts": {
    "build:contracts": "npm run build -w @liquidation-shield/contracts",
    "test:contracts": "npm test -w @liquidation-shield/contracts",
    "abis": "npm run build:contracts && npm run abis -w @liquidation-shield/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo:deploy": "node --env-file-if-exists=.env --import tsx demo/src/bin/deploy.ts",
    "demo:seed": "node --env-file-if-exists=.env --import tsx demo/src/bin/seed.ts",
    "demo:crash": "node --env-file-if-exists=.env --import tsx demo/src/bin/crash.ts",
    "demo:liquidator": "node --env-file-if-exists=.env --import tsx demo/src/bin/liquidator.ts",
    "keeper": "node --env-file-if-exists=.env --import tsx keeper/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
